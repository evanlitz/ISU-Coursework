<mujoco model="chess_set">
    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .1 .1" rgb2=".9 .9 .9" width="512" height="512"/>
        <material name="board_mat" texture="grid" texrepeat="4 4" reflectance="0.2"/>
        <material name="white_piece" rgba="0.9 0.9 0.9 1"/>
        <material name="black_piece" rgba="0.2 0.2 0.2 1"/>
    </asset>

    <worldbody>
        <body name="chess_set_root" pos="0 0 0.5"> 
            
            <geom name="board_geom" type="box" size="0.4 0.4 0.02" material="board_mat"/>

            <body name="w_pawn_1" pos="-0.35 -0.25 0.04">
                <joint type="free" damping="0.01"/>
                <geom type="cylinder" size="0.025 0.03" material="white_piece"/>
            </body>
            
            <body name="w_king" pos="-0.35 0.05 0.07">
                <joint type="free" damping="0.01"/>
                <geom type="cylinder" size="0.03 0.06" material="white_piece"/>
            </body>

            <body name="b_pawn_1" pos="0.35 -0.25 0.04">
                <joint type="free" damping="0.01"/>
                <geom type="cylinder" size="0.025 0.03" material="black_piece"/>
            </body>

            <body name="b_king" pos="0.35 0.05 0.07">
                <joint type="free" damping="0.01"/>
                <geom type="cylinder" size="0.03 0.06" material="black_piece"/>
            </body>
        </body>
    </worldbody>
</mujoco>